  "cards": [
    {
      "dot": "emerald",
      "title": "包络是什么",
      "items": [
        "把音频切成一格一格（这里 20 ms 一格）",
        "每格只留两个数：最大振幅、平均响度",
        "画成曲线后，51 秒的音频变成一条高低起伏的线"
      ]
    },
    {
      "dot": "orange",
      "title": "怎么读边界",
      "items": [
        "曲线起伏大 = 点火、轰油，瞬间变化多",
        "曲线平直 = 稳定怠速，声音一直在重复",
        "平坦段的起止位置，就是天然的切分点"
      ]
    },
    {
      "dot": "cyan",
      "title": "切完怎么用",
      "items": [
        "平直段里取 30–40 s，接缝做 80 ms 交叉淡化",
        "起伏段只取开头 0–3.4 s 当点火音效",
        "剩余素材不用，循环体越小越省内存"
      ]
    }
  ]
}